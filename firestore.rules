rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Safety Net (Default Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isWhitelistedFounder() {
      return request.auth != null && (
        request.auth.token.email == 'mayankraj.mfp23@gmail.com' ||
        request.auth.token.email == 'mayankraj.mfp26@gmail.com' ||
        request.auth.token.email == 'mayankraj.mfp29@gmail.com'
      );
    }

    // Entity Blueprints (Pillar 2: Anti-Update-Gap)
    function isValidProfile(data) {
      return data.keys().hasAll([
        'uid',
        'username',
        'discriminator',
        'uniqueTag',
        'avatarUrl',
        'bannerUrl',
        'bannerColor',
        'bio',
        'customStatusText',
        'customStatusEmoji',
        'profileThemeColor',
        'status',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid',
        'username',
        'discriminator',
        'uniqueTag',
        'avatarUrl',
        'bannerUrl',
        'bannerColor',
        'bio',
        'customStatusText',
        'customStatusEmoji',
        'profileThemeColor',
        'status',
        'isLive',
        'liveStreamUrl',
        'liveStreamTitle',
        'createdAt',
        'updatedAt'
      ]) &&
      isValidId(data.uid) &&
      data.uid == request.auth.uid &&
      data.username is string && data.username.size() >= 2 && data.username.size() <= 32 &&
      data.discriminator is string && data.discriminator.size() == 4 && data.discriminator.matches('^[0-9]{4}$') &&
      data.uniqueTag is string && data.uniqueTag.size() >= 7 && data.uniqueTag.size() <= 40 &&
      data.avatarUrl is string && data.avatarUrl.size() <= 500000 &&
      data.bannerUrl is string && data.bannerUrl.size() <= 500000 &&
      data.bannerColor is string && data.bannerColor.size() >= 4 && data.bannerColor.size() <= 9 &&
      data.bio is string && data.bio.size() <= 300 &&
      data.customStatusText is string && data.customStatusText.size() <= 128 &&
      data.customStatusEmoji is string && data.customStatusEmoji.size() <= 32 &&
      data.profileThemeColor is string && data.profileThemeColor.size() >= 4 && data.profileThemeColor.size() <= 9 &&
      data.status is string && data.status.size() <= 16 &&
      (data.status == 'online' || data.status == 'idle' || data.status == 'dnd' || data.status == 'offline') &&
      (!('isLive' in data) || data.isLive is bool) &&
      (!('liveStreamUrl' in data) || (data.liveStreamUrl is string && data.liveStreamUrl.size() <= 2048)) &&
      (!('liveStreamTitle' in data) || (data.liveStreamTitle is string && data.liveStreamTitle.size() <= 140)) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidFriendRelationship(data) {
      return data.keys().hasAll(['id', 'userId', 'friendId', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'userId', 'friendId', 'status', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.userId) &&
        isValidId(data.friendId) &&
        data.userId != data.friendId &&
        (data.userId == request.auth.uid || data.friendId == request.auth.uid) &&
        data.status is string && data.status.size() <= 24 &&
        (
          data.status == 'pending_incoming' ||
          data.status == 'pending_outgoing' ||
          data.status == 'accepted' ||
          data.status == 'blocked'
        ) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidDirectMessage(data) {
      return data.keys().hasAll([
          'id',
          'conversationId',
          'channelId',
          'serverId',
          'senderId',
          'receiverId',
          'authorId',
          'authorName',
          'content',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'conversationId',
          'channelId',
          'serverId',
          'senderId',
          'receiverId',
          'authorId',
          'authorName',
          'authorAvatar',
          'authorRoleColor',
          'content',
          'gifUrl',
          'attachmentUrl',
          'attachmentAnalysis',
          'replyTo',
          'reactions',
          'isBot',
          'botName',
          'botEmbed',
          'isEdited',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.conversationId) &&
        isValidId(data.channelId) &&
        isValidId(data.serverId) &&
        isValidId(data.senderId) &&
        isValidId(data.receiverId) &&
        isValidId(data.authorId) &&
        data.senderId == data.authorId &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 64 &&
        (!('authorAvatar' in data) || (data.authorAvatar is string && data.authorAvatar.size() <= 500000)) &&
        (!('authorRoleColor' in data) || (data.authorRoleColor is string && data.authorRoleColor.size() <= 16)) &&
        data.content is string && data.content.size() <= 4000 &&
        (!('gifUrl' in data) || (data.gifUrl is string && data.gifUrl.size() <= 500000)) &&
        (!('attachmentUrl' in data) || (data.attachmentUrl is string && data.attachmentUrl.size() <= 600000)) &&
        (!('attachmentAnalysis' in data) || (data.attachmentAnalysis is string && data.attachmentAnalysis.size() <= 4000)) &&
        (!('replyTo' in data) || (data.replyTo is map && data.replyTo.size() <= 10)) &&
        (!('reactions' in data) || (data.reactions is map && data.reactions.size() <= 50)) &&
        (!('isBot' in data) || data.isBot is bool) &&
        (!('botName' in data) || (data.botName is string && data.botName.size() <= 64)) &&
        (!('botEmbed' in data) || (data.botEmbed is map && data.botEmbed.size() <= 15)) &&
        (!('isEdited' in data) || data.isEdited is bool) &&
        (!('updatedAt' in data) || data.updatedAt is timestamp) &&
        data.createdAt is timestamp;
    }

    function isValidServer(data) {
      return data.keys().hasAll(['id', 'name', 'ownerId', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'id',
          'name',
          'description',
          'iconUrl',
          'inviteCode',
          'ownerId',
          'roles',
          'memberRoles',
          'customEmojis',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 80 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 300)) &&
        (!('iconUrl' in data) || (data.iconUrl is string && data.iconUrl.size() <= 500000)) &&
        (!('inviteCode' in data) || (data.inviteCode is string && data.inviteCode.size() <= 64)) &&
        (!('roles' in data) || (data.roles is list && data.roles.size() <= 30)) &&
        (!('memberRoles' in data) || (data.memberRoles is map && data.memberRoles.size() <= 100)) &&
        (!('customEmojis' in data) || (data.customEmojis is list && data.customEmojis.size() <= 100)) &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidServerMember(data) {
      return data.keys().hasAll(['id', 'serverId', 'userId', 'username', 'joinedAt']) &&
        data.keys().hasOnly(['id', 'serverId', 'userId', 'username', 'avatarUrl', 'joinedAt']) &&
        isValidId(data.id) &&
        isValidId(data.serverId) &&
        isValidId(data.userId) &&
        data.userId == request.auth.uid &&
        data.username is string && data.username.size() >= 1 && data.username.size() <= 32 &&
        (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 500000)) &&
        data.joinedAt is timestamp;
    }

    function isValidChannel(data) {
      return data.keys().hasAll(['id', 'serverId', 'name', 'type', 'category', 'ownerId', 'createdAt']) &&
        data.keys().hasOnly([
          'id',
          'serverId',
          'name',
          'type',
          'category',
          'topic',
          'ownerId',
          'createdAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.serverId) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 64 &&
        data.type is string && data.type.size() <= 16 &&
        (data.type == 'text' || data.type == 'voice') &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 48 &&
        (!('topic' in data) || (data.topic is string && data.topic.size() <= 300)) &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        data.createdAt is timestamp;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['id', 'channelId', 'serverId', 'authorId', 'authorName', 'content', 'createdAt']) &&
        data.keys().hasOnly([
          'id',
          'channelId',
          'serverId',
          'authorId',
          'authorName',
          'authorAvatar',
          'authorRoleColor',
          'content',
          'gifUrl',
          'attachmentUrl',
          'attachmentAnalysis',
          'replyTo',
          'reactions',
          'isBot',
          'botName',
          'botEmbed',
          'isEdited',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.channelId) &&
        isValidId(data.serverId) &&
        isValidId(data.authorId) &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 64 &&
        (!('authorAvatar' in data) || (data.authorAvatar is string && data.authorAvatar.size() <= 500000)) &&
        (!('authorRoleColor' in data) || (data.authorRoleColor is string && data.authorRoleColor.size() <= 16)) &&
        data.content is string && data.content.size() <= 4000 &&
        (!('gifUrl' in data) || (data.gifUrl is string && data.gifUrl.size() <= 500000)) &&
        (!('attachmentUrl' in data) || (data.attachmentUrl is string && data.attachmentUrl.size() <= 600000)) &&
        (!('attachmentAnalysis' in data) || (data.attachmentAnalysis is string && data.attachmentAnalysis.size() <= 4000)) &&
        (!('replyTo' in data) || (data.replyTo is map && data.replyTo.size() <= 10)) &&
        (!('reactions' in data) || (data.reactions is map && data.reactions.size() <= 50)) &&
        (!('isBot' in data) || data.isBot is bool) &&
        (!('botName' in data) || (data.botName is string && data.botName.size() <= 64)) &&
        (!('botEmbed' in data) || (data.botEmbed is map && data.botEmbed.size() <= 15)) &&
        (!('isEdited' in data) || data.isEdited is bool) &&
        (!('updatedAt' in data) || data.updatedAt is timestamp) &&
        data.createdAt is timestamp;
    }

    // 1. Public User Profiles (/profiles/{userId}) - Non-PII public profile card
    match /profiles/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (resource == null || existing().uid is string);
      allow list: if isSignedIn() && resource.data.uid is string;

      allow create: if isSignedIn() &&
        isValidId(userId) &&
        userId == request.auth.uid &&
        isValidProfile(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isSignedIn() &&
        isValidProfile(incoming()) &&
        isValidId(userId) &&
        userId == request.auth.uid &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'username',
            'discriminator',
            'uniqueTag',
            'avatarUrl',
            'bannerUrl',
            'bannerColor',
            'bio',
            'customStatusText',
            'customStatusEmoji',
            'profileThemeColor',
            'status',
            'isLive',
            'liveStreamUrl',
            'liveStreamTitle',
            'updatedAt'
          ])
        );
    }

    // 2. Friends Social Graph (/friends/{friendshipId})
    match /friends/{friendshipId} {
      allow get: if isSignedIn() &&
        isValidId(friendshipId) &&
        (resource == null || existing().userId == request.auth.uid || existing().friendId == request.auth.uid);

      allow list: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || resource.data.friendId == request.auth.uid);

      allow create: if isSignedIn() &&
        isValidId(friendshipId) &&
        isValidFriendRelationship(incoming()) &&
        incoming().id == friendshipId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/profiles/$(request.auth.uid));

      allow update: if isSignedIn() &&
        isValidFriendRelationship(incoming()) &&
        isValidId(friendshipId) &&
        (existing().userId == request.auth.uid || existing().friendId == request.auth.uid) &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId &&
        incoming().friendId == existing().friendId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);

      allow delete: if isSignedIn() &&
        isValidId(friendshipId) &&
        (existing().userId == request.auth.uid || existing().friendId == request.auth.uid);
    }

    // 2b. Real-Time Direct Messages (/direct_messages/{messageId})
    match /direct_messages/{messageId} {
      allow get: if isSignedIn() &&
        isValidId(messageId) &&
        (resource == null || existing().senderId == request.auth.uid || existing().receiverId == request.auth.uid);

      allow list: if isSignedIn() &&
        (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);

      allow create: if isSignedIn() &&
        isValidId(messageId) &&
        isValidDirectMessage(incoming()) &&
        incoming().id == messageId &&
        incoming().senderId == request.auth.uid &&
        incoming().authorId == request.auth.uid &&
        incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/profiles/$(request.auth.uid));

      allow update: if isSignedIn() &&
        isValidDirectMessage(incoming()) &&
        isValidId(messageId) &&
        (existing().senderId == request.auth.uid || existing().receiverId == request.auth.uid) &&
        incoming().id == existing().id &&
        incoming().conversationId == existing().conversationId &&
        incoming().channelId == existing().channelId &&
        incoming().serverId == existing().serverId &&
        incoming().senderId == existing().senderId &&
        incoming().receiverId == existing().receiverId &&
        incoming().authorId == existing().authorId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            incoming().content == existing().content &&
            incoming().diff(existing()).affectedKeys().hasOnly(['reactions', 'updatedAt'])
          ) ||
          (
            existing().senderId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['content', 'isEdited', 'updatedAt'])
          )
        );

      allow delete: if isSignedIn() &&
        isValidId(messageId) &&
        (existing().senderId == request.auth.uid || existing().receiverId == request.auth.uid || isWhitelistedFounder());
    }

    // 3. Community Servers (/servers/{serverId})
    match /servers/{serverId} {
      allow get: if isSignedIn() && isValidId(serverId) && (resource == null || existing().ownerId is string);
      allow list: if isSignedIn() && resource.data.ownerId is string;

      allow create: if isSignedIn() &&
        isValidId(serverId) &&
        isValidServer(incoming()) &&
        incoming().id == serverId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isSignedIn() &&
        isValidServer(incoming()) &&
        isValidId(serverId) &&
        existing().ownerId == request.auth.uid &&
        incoming().id == existing().id &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name',
          'description',
          'iconUrl',
          'inviteCode',
          'roles',
          'memberRoles',
          'customEmojis',
          'updatedAt'
        ]);

      allow delete: if isSignedIn() &&
        isValidId(serverId) &&
        (existing().ownerId == request.auth.uid || isWhitelistedFounder());

      // 3b. Server Members Subcollection (/servers/{serverId}/members/{memberId})
      match /members/{memberId} {
        allow get: if isSignedIn() &&
          isValidId(serverId) &&
          isValidId(memberId) &&
          (resource == null || existing().serverId == serverId);

        allow list: if isSignedIn() && resource.data.serverId == serverId;

        allow create: if isSignedIn() &&
          isValidId(serverId) &&
          isValidId(memberId) &&
          memberId == request.auth.uid &&
          isValidServerMember(incoming()) &&
          incoming().id == memberId &&
          incoming().serverId == serverId &&
          incoming().joinedAt == request.time &&
          exists(/databases/$(database)/documents/servers/$(serverId));

        allow delete: if isSignedIn() &&
          isValidId(serverId) &&
          isValidId(memberId) &&
          existing().userId == request.auth.uid;
      }

      // 4. Server Channels (/servers/{serverId}/channels/{channelId})
      match /channels/{channelId} {
        allow get: if isSignedIn() &&
          isValidId(serverId) &&
          isValidId(channelId) &&
          (resource == null || existing().serverId == serverId);

        allow list: if isSignedIn() && resource.data.serverId == serverId;

        allow create: if isSignedIn() &&
          isValidId(serverId) &&
          isValidId(channelId) &&
          isValidChannel(incoming()) &&
          incoming().id == channelId &&
          incoming().serverId == serverId &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/servers/$(serverId));

        allow update: if isSignedIn() &&
          isValidId(serverId) &&
          isValidId(channelId) &&
          isValidChannel(incoming()) &&
          incoming().id == existing().id &&
          incoming().serverId == existing().serverId &&
          incoming().createdAt == existing().createdAt &&
          (
            existing().ownerId == request.auth.uid ||
            get(/databases/$(database)/documents/servers/$(serverId)).data.ownerId == request.auth.uid ||
            isWhitelistedFounder()
          ) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'topic']);

        allow delete: if isSignedIn() &&
          isValidId(serverId) &&
          isValidId(channelId) &&
          (
            existing().ownerId == request.auth.uid ||
            get(/databases/$(database)/documents/servers/$(serverId)).data.ownerId == request.auth.uid ||
            isWhitelistedFounder()
          );

        // 5. Channel Messages (/servers/{serverId}/channels/{channelId}/messages/{messageId})
        match /messages/{messageId} {
          allow get: if isSignedIn() &&
            isValidId(serverId) &&
            isValidId(channelId) &&
            isValidId(messageId) &&
            (resource == null || existing().channelId == channelId);

          allow list: if isSignedIn() && resource.data.channelId == channelId;

          allow create: if isSignedIn() &&
            isValidId(serverId) &&
            isValidId(channelId) &&
            isValidId(messageId) &&
            isValidMessage(incoming()) &&
            incoming().authorId == request.auth.uid &&
            incoming().id == messageId &&
            incoming().channelId == channelId &&
            incoming().serverId == serverId &&
            incoming().createdAt == request.time &&
            exists(/databases/$(database)/documents/servers/$(serverId)/channels/$(channelId));

          allow update: if isSignedIn() &&
            isValidMessage(incoming()) &&
            isValidId(serverId) &&
            isValidId(channelId) &&
            isValidId(messageId) &&
            incoming().id == existing().id &&
            incoming().channelId == existing().channelId &&
            incoming().serverId == existing().serverId &&
            incoming().authorId == existing().authorId &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            (
              // Action 1: Any signed-in member toggling a reaction on a message
              (
                incoming().content == existing().content &&
                incoming().diff(existing()).affectedKeys().hasOnly(['reactions', 'updatedAt'])
              ) ||
              // Action 2: Message author editing message content
              (
                existing().authorId == request.auth.uid &&
                incoming().diff(existing()).affectedKeys().hasOnly(['content', 'isEdited', 'updatedAt'])
              )
            );

          allow delete: if isSignedIn() &&
            isValidId(serverId) &&
            isValidId(channelId) &&
            isValidId(messageId) &&
            (
              existing().authorId == request.auth.uid ||
              get(/databases/$(database)/documents/servers/$(serverId)).data.ownerId == request.auth.uid ||
              isWhitelistedFounder()
            );
        }
      }
    }
  }
}
